MAIL_FROM_NAME=

# ── MISC ──────────────────────────────────────────────────────────────

FILESYSTEM_DISK=local
LOG_CHANNEL=stack
# Debug-level logging can write sensitive data to your log files — SQL
# query parameters, request payloads, full stack traces with internal file
# paths. Fine for local development, but change to a higher level for
# production deployment:
LOG_LEVEL=debug
# LOG_LEVEL=error


# ────────────────────────────────────────────────────────────────────
# WHEN GOING LIVE ON VPS — change these values:
#
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://millionaire.pk
#
# MAIL_HOST=mail.millionaire.pk
# MAIL_PORT=587
# MAIL_USERNAME=noreply@millionaire.pk
# MAIL_PASSWORD=your_cpanel_email_password
# MAIL_FROM_ADDRESS=noreply@millionaire.pk
#
# PAYFAST_SANDBOX=false
#
# CACHE_STORE=file   (or redis if you install it)
# QUEUE_CONNECTION=database  (for background emails)
# SESSION_DRIVER=file
#
# INERTIA_SSR_ENABLED=true
# INERTIA_SSR_URL=http://127.0.0.1:13714
# ────────────────────────────────────────────────────────────────────

# Comma-separated IPs that should never be auto-blocked by the DDoS/spam
# firewall (app/Http/Middleware/IpFirewall.php) — add your own office/home
# IP here so testing your own site doesn't risk locking you out of it.
FIREWALL_WHITELIST=
