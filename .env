# query parameters, request payloads, full stack traces with internal file
# paths. Fine for local development, but change to a higher level for
# production deployment:
LOG_LEVEL=debug
# LOG_LEVEL=error


# ────────────────────────────────────────────────────────────────────
# WHEN GOING LIVE ON VPS — change these values:
