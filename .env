# APP_DEBUG=false
# APP_URL=https://millionaire.pk
#
# MAIL_HOST=mail.millionaire.pk
# MAIL_PORT=587
# MAIL_USERNAME=noreply@millionaire.pk
# MAIL_PASSWORD=your_cpanel_email_password
# MAIL_FROM_ADDRESS=noreply@millionaire.pk
#
# PAYFAST_SANDBOX=false
#
# CACHE_STORE=file   (or redis if you install it)
# QUEUE_CONNECTION=database  (for background emails)
# SESSION_DRIVER=file
#
# INERTIA_SSR_ENABLED=true
# INERTIA_SSR_URL=http://127.0.0.1:13714
# ────────────────────────────────────────────────────────────────────

# ── Reverb (real-time chat) — NOT active yet ────────────────────────
# 1. Run: composer require laravel/reverb
# 2. Run: php artisan install:broadcasting   (select "reverb" when prompted —
#    this creates config/broadcasting.php and fills in real REVERB_* values)
# 3. Change BROADCAST_CONNECTION above from "log" to "reverb"
# 4. Keep this running continuously on the server: php artisan reverb:start
# Until all 4 steps are done, chat automatically falls back to a lightweight
# 15-second poll — it keeps working either way, just faster once this is set up.

# Comma-separated IPs that should never be auto-blocked by the DDoS/spam
# firewall (app/Http/Middleware/IpFirewall.php) — add your own office/home
# IP here so testing your own site doesn't risk locking you out of it.
FIREWALL_WHITELIST=


BROADCAST_CONNECTION=reverb
REVERB_APP_ID=BFOOJEeL1fSh
REVERB_APP_KEY=nCkb5mX0aLD2hLqSDhcR
REVERB_APP_SECRET=WqHPJuZDzRCInGglMSCe
# REVERB_HOST="localhost"
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"